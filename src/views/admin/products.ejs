<div class="container-fluid px-md-4 py-3">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
      <h3 class="fw-bold mb-1"><i class="fa-solid fa-bowl-food text-primary me-2"></i> Quản Lý Món Ăn</h3>
      <p class="text-muted small mb-0">Thêm mới, sửa thông tin, giá bán, tùy chọn và trạng thái còn/hết hàng</p>
    </div>
    <div>
      <button class="btn btn-primary rounded-pill px-4 fw-semibold" onclick="openCreateProductModal()">
        <i class="fa-solid fa-plus me-1"></i> Thêm Món Mới
      </button>
    </div>
  </div>

  <div class="custom-card p-4 border-0 shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th style="width: 70px;">Hình ảnh</th>
            <th>Tên Món</th>
            <th>Danh Mục</th>
            <th>Giá Bán</th>
            <th>Đã Bán</th>
            <th>Trạng Thái Kho</th>
            <th class="text-end">Hành Động</th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach(p=> { %>
            <tr id="prod-row-<%= p._id %>">
              <td>
                <img src="<%= (p.images && p.images[0]) || '/images/default-food.png' %>" class="rounded-3"
                  style="width: 50px; height: 50px; object-fit: cover;">
              </td>
              <td>
                <div class="fw-bold text-dark">
                  <%= p.name %>
                </div>
                <div class="small text-muted text-truncate" style="max-width: 250px;">
                  <%= p.description || 'Chưa có mô tả' %>
                </div>
              </td>
              <td>
                <span class="badge bg-light text-dark border">
                  <%= p.category ? p.category.name : 'N/A' %>
                </span>
              </td>
              <td class="fw-bold text-primary">
                <%= p.price.toLocaleString('vi-VN') %>đ
              </td>
              <td>
                <%= p.soldCount %>
              </td>
              <td>
                <div class="form-check form-switch">
                  <input class="form-check-input" type="checkbox" role="switch" <%=p.isAvailable ? 'checked' : '' %>
                  onchange="toggleProductStock('<%= p._id %>', this.checked)">
                    <label
                      class="form-check-label small <%= p.isAvailable ? 'text-success fw-semibold' : 'text-danger' %>">
                      <%= p.isAvailable ? 'Còn hàng' : 'Hết hàng' %>
                    </label>
                </div>
              </td>
              <td class="text-end">
                <button class="btn btn-sm btn-outline-secondary rounded-circle me-1" style="width: 34px; height: 34px;"
                  onclick="openEditProductModal(<%= JSON.stringify(p) %>)" title="Sửa món">
                  <i class="fa-solid fa-pen"></i>
                </button>
                <button class="btn btn-sm btn-outline-danger rounded-circle" style="width: 34px; height: 34px;"
                  onclick="deleteProduct('<%= p._id %>')" title="Xóa món">
                  <i class="fa-solid fa-trash"></i>
                </button>
              </td>
            </tr>
            <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal Thêm/Sửa Món -->
<div class="modal fade" id="productModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
    <div class="modal-content border-0 shadow-lg">
      <div class="modal-header">
        <h5 class="modal-title fw-bold" id="productModalTitle">Thêm Món Mới</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-4">
        <form id="productForm">
          <input type="hidden" id="productId">

          <div class="row g-3">
            <div class="col-md-7">
              <label class="form-label fw-semibold">Tên món <span class="text-danger">*</span></label>
              <input type="text" id="pName" class="form-control" required placeholder="Trà Sữa Oolong Nướng...">
            </div>

            <div class="col-md-5">
              <label class="form-label fw-semibold">Danh mục <span class="text-danger">*</span></label>
              <select id="pCategory" class="form-select" required>
                <% categories.forEach(c=> { %>
                  <option value="<%= c._id %>">
                    <%= c.name %>
                  </option>
                  <% }) %>
              </select>
            </div>

            <div class="col-md-6">
              <label class="form-label fw-semibold">Giá bán (VNĐ) <span class="text-danger">*</span></label>
              <input type="number" id="pPrice" class="form-control" required min="0" step="1000" placeholder="35000">
            </div>

            <div class="col-md-6">
              <label class="form-label fw-semibold">Tags</label>
              <input type="text" id="pTags" class="form-control" placeholder="bestseller, tra-sua, hot">
            </div>

            <div class="col-12">
              <label class="form-label fw-semibold">Mô tả món ăn</label>
              <textarea id="pDesc" class="form-control" rows="2" placeholder="Hương vị đậm đà..."></textarea>
            </div>

            <div class="col-12">
              <label class="form-label fw-semibold">Ảnh món ăn (Upload file)</label>
              <input type="file" id="pImage" class="form-control" accept="image/*">
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Hủy</button>
        <button type="button" class="btn btn-primary rounded-pill px-4" id="btnSaveProduct" onclick="saveProduct()">Lưu
          Món Ăn</button>
      </div>
    </div>
  </div>
</div>

<script>
  let editingProductId = null;

  function openCreateProductModal() {
    editingProductId = null;
    document.getElementById('productModalTitle').textContent = 'Thêm Món Mới';
    document.getElementById('productForm').reset();
    document.getElementById('productId').value = '';
    new bootstrap.Modal(document.getElementById('productModal')).show();
  }

  function openEditProductModal(p) {
    editingProductId = p._id;
    document.getElementById('productModalTitle').textContent = `Chỉnh Sửa: ${p.name}`;
    document.getElementById('productId').value = p._id;
    document.getElementById('pName').value = p.name;
    document.getElementById('pCategory').value = p.category ? (p.category._id || p.category) : '';
    document.getElementById('pPrice').value = p.price;
    document.getElementById('pDesc').value = p.description || '';
    document.getElementById('pTags').value = (p.tags || []).join(', ');
    new bootstrap.Modal(document.getElementById('productModal')).show();
  }

  async function saveProduct() {
    const name = document.getElementById('pName').value.trim();
    const category = document.getElementById('pCategory').value;
    const price = document.getElementById('pPrice').value;
    const description = document.getElementById('pDesc').value.trim();
    const tags = document.getElementById('pTags').value.trim();
    const fileInput = document.getElementById('pImage');

    if (!name || !category || !price) {
      Swal.fire({ icon: 'warning', title: 'Thiếu thông tin', text: 'Vui lòng nhập đầy đủ các trường bắt buộc' });
      return;
    }

    const formData = new FormData();
    formData.append('name', name);
    formData.append('category', category);
    formData.append('price', price);
    formData.append('description', description);
    formData.append('tags', tags);
    if (fileInput.files[0]) {
      formData.append('image', fileInput.files[0]);
    }

    const btn = document.getElementById('btnSaveProduct');
    btn.disabled = true;

    try {
      const url = editingProductId ? `/api/admin/products/${editingProductId}` : '/api/admin/products';
      const method = editingProductId ? 'PUT' : 'POST';

      const res = await fetch(url, {
        method,
        body: formData
      });
      const result = await res.json();
      if (!result.success) {
        const detailMsg = (result.errors && result.errors.length)
          ? result.errors.map(e => e.message).join('<br>')
          : result.message;
        throw new Error(detailMsg);
      }

      bootstrap.Modal.getInstance(document.getElementById('productModal')).hide();
      await Swal.fire({ icon: 'success', title: 'Thành công!', text: 'Đã lưu thông tin món ăn.' });
      window.location.reload();
    } catch (err) {
      Swal.fire({ icon: 'error', title: 'Lỗi', text: err.message });
    } finally {
      btn.disabled = false;
    }
  }

  async function toggleProductStock(id, isAvailable) {
    try {
      const res = await fetch(`/api/admin/products/${id}/availability`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ isAvailable })
      });
      const result = await res.json();
      if (!result.success) throw new Error(result.message);
    } catch (err) {
      Swal.fire({ icon: 'error', title: 'Lỗi', text: err.message });
    }
  }

  async function deleteProduct(id) {
    const confirm = await Swal.fire({
      title: 'Ẩn món này khỏi thực đơn?',
      text: 'Món ăn sẽ không hiển thị cho khách đặt nữa.',
      icon: 'warning',
      showCancelButton: true,
      confirmButtonText: 'Đồng ý'
    });
    if (!confirm.isConfirmed) return;

    try {
      const res = await fetch(`/api/admin/products/${id}`, { method: 'DELETE' });
      const result = await res.json();
      if (!result.success) throw new Error(result.message);

      document.getElementById(`prod-row-${id}`).remove();
      Swal.fire({ icon: 'success', title: 'Đã ẩn món ăn thành công' });
    } catch (err) {
      Swal.fire({ icon: 'error', title: 'Lỗi', text: err.message });
    }
  }
</script>