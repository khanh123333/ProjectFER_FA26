<div class="container-fluid px-md-4 py-3">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
      <h3 class="fw-bold mb-1"><i class="fa-solid fa-list text-primary me-2"></i> Quản Lý Danh Mục</h3>
      <p class="text-muted small mb-0">Các nhóm sản phẩm như Trà sữa, Cà phê, Nước ép, Đồ ăn vặt...</p>
    </div>
    <div>
      <button class="btn btn-primary rounded-pill px-4 fw-semibold" onclick="openCreateCategoryModal()">
        <i class="fa-solid fa-plus me-1"></i> Thêm Danh Mục
      </button>
    </div>
  </div>

  <div class="custom-card p-4 border-0 shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th style="width: 70px;">Hình ảnh</th>
            <th>Tên Danh Mục</th>
            <th>Slug</th>
            <th>Loại</th>
            <th>Thứ Tự</th>
            <th>Trạng Thái</th>
            <th class="text-end">Hành Động</th>
          </tr>
        </thead>
        <tbody>
          <% categories.forEach(c => { %>
            <tr id="cat-row-<%= c._id %>">
              <td>
                <img src="<%= c.image || '/images/default-category.png' %>" class="rounded-3" style="width: 50px; height: 50px; object-fit: cover;">
              </td>
              <td class="fw-bold"><%= c.name %></td>
              <td><code><%= c.slug %></code></td>
              <td><span class="badge bg-light text-dark border text-uppercase"><%= c.type %></span></td>
              <td><%= c.sortOrder %></td>
              <td>
                <span class="badge <%= c.isActive ? 'bg-success' : 'bg-secondary' %>">
                  <%= c.isActive ? 'Hoạt động' : 'Tạm ẩn' %>
                </span>
              </td>
              <td class="text-end">
                <button class="btn btn-sm btn-outline-secondary rounded-circle me-1" style="width: 34px; height: 34px;" 
                        onclick="openEditCategoryModal(<%= JSON.stringify(c) %>)" title="Sửa">
                  <i class="fa-solid fa-pen"></i>
                </button>
                <button class="btn btn-sm btn-outline-danger rounded-circle" style="width: 34px; height: 34px;" 
                        onclick="deleteCategory('<%= c._id %>')" title="Xóa">
                  <i class="fa-solid fa-trash"></i>
                </button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal Thêm/Sửa Danh Mục -->
<div class="modal fade" id="categoryModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg">
      <div class="modal-header">
        <h5 class="modal-title fw-bold" id="catModalTitle">Thêm Danh Mục Mới</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-4">
        <form id="categoryForm">
          <input type="hidden" id="catId">

          <div class="mb-3">
            <label class="form-label fw-semibold">Tên danh mục <span class="text-danger">*</span></label>
            <input type="text" id="catName" class="form-control" required placeholder="Cà Phê Pha Máy...">
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Loại hình</label>
            <select id="catType" class="form-select">
              <option value="drink">Đồ uống (Drink)</option>
              <option value="food">Đồ ăn (Food)</option>
              <option value="other">Khác (Other)</option>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Thứ tự hiển thị</label>
            <input type="number" id="catSortOrder" class="form-control" value="0" min="0">
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Mô tả</label>
            <textarea id="catDesc" class="form-control" rows="2"></textarea>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Hình ảnh (Upload)</label>
            <input type="file" id="catImage" class="form-control" accept="image/*">
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Hủy</button>
        <button type="button" class="btn btn-primary rounded-pill px-4" id="btnSaveCat" onclick="saveCategory()">Lưu Danh Mục</button>
      </div>
    </div>
  </div>
</div>

<script>
let editingCatId = null;

function openCreateCategoryModal() {
  editingCatId = null;
  document.getElementById('catModalTitle').textContent = 'Thêm Danh Mục Mới';
  document.getElementById('categoryForm').reset();
  document.getElementById('catId').value = '';
  new bootstrap.Modal(document.getElementById('categoryModal')).show();
}

function openEditCategoryModal(c) {
  editingCatId = c._id;
  document.getElementById('catModalTitle').textContent = `Chỉnh Sửa: ${c.name}`;
  document.getElementById('catId').value = c._id;
  document.getElementById('catName').value = c.name;
  document.getElementById('catType').value = c.type;
  document.getElementById('catSortOrder').value = c.sortOrder || 0;
  document.getElementById('catDesc').value = c.description || '';
  new bootstrap.Modal(document.getElementById('categoryModal')).show();
}

async function saveCategory() {
  const name = document.getElementById('catName').value.trim();
  const type = document.getElementById('catType').value;
  const sortOrder = document.getElementById('catSortOrder').value;
  const description = document.getElementById('catDesc').value.trim();
  const fileInput = document.getElementById('catImage');

  if (!name) {
    Swal.fire({ icon: 'warning', title: 'Thiếu thông tin', text: 'Tên danh mục không được để trống' });
    return;
  }

  const formData = new FormData();
  formData.append('name', name);
  formData.append('type', type);
  formData.append('sortOrder', sortOrder);
  formData.append('description', description);
  if (fileInput.files[0]) {
    formData.append('image', fileInput.files[0]);
  }

  const btn = document.getElementById('btnSaveCat');
  btn.disabled = true;

  try {
    const url = editingCatId ? `/api/admin/categories/${editingCatId}` : '/api/admin/categories';
    const method = editingCatId ? 'PUT' : 'POST';

    const res = await fetch(url, { method, body: formData });
    const result = await res.json();
    if (!result.success) throw new Error(result.message);

    bootstrap.Modal.getInstance(document.getElementById('categoryModal')).hide();
    await Swal.fire({ icon: 'success', title: 'Thành công', text: 'Đã lưu danh mục!' });
    window.location.reload();
  } catch (err) {
    Swal.fire({ icon: 'error', title: 'Lỗi', text: err.message });
  } finally {
    btn.disabled = false;
  }
}

async function deleteCategory(id) {
  const confirm = await Swal.fire({
    title: 'Xóa danh mục này?',
    text: 'Hành động không thể hoàn tác nếu danh mục chưa chứa món nào.',
    icon: 'warning',
    showCancelButton: true,
    confirmButtonText: 'Đồng ý xóa'
  });
  if (!confirm.isConfirmed) return;

  try {
    const res = await fetch(`/api/admin/categories/${id}`, { method: 'DELETE' });
    const result = await res.json();
    if (!result.success) throw new Error(result.message);

    document.getElementById(`cat-row-${id}`).remove();
    Swal.fire({ icon: 'success', title: 'Đã xóa danh mục' });
  } catch (err) {
    Swal.fire({ icon: 'error', title: 'Lỗi', text: err.message });
  }
}
</script>
