<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="container-fluid px-md-4 py-3">
  <!-- Header -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
      <h3 class="fw-bold mb-1"><i class="fa-solid fa-chart-line text-primary me-2"></i> Báo Cáo & Thống Kê Doanh Thu</h3>
      <p class="text-muted small mb-0">Theo dõi doanh thu, hiệu suất bán hàng và các món được yêu thích nhất</p>
    </div>
    <div class="d-flex gap-2 mt-3 mt-md-0">
      <a href="/api/admin/reports/export-excel" class="btn btn-success btn-sm rounded-pill px-3 fw-semibold">
        <i class="fa-solid fa-file-excel me-1"></i> Xuất File Excel
      </a>
      <button class="btn btn-primary btn-sm rounded-pill px-3 fw-semibold" onclick="loadDashboardStats()">
        <i class="fa-solid fa-arrows-rotate me-1"></i> Làm Mới
      </button>
    </div>
  </div>

  <!-- Key Metrics Cards -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
      <div class="custom-card p-3 border-0 shadow-sm border-start border-4 border-primary">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <div class="text-muted small fw-semibold">TỔNG DOANH THU</div>
            <div class="fs-4 fw-bold text-dark mt-1" id="statRevenue">0đ</div>
          </div>
          <div class="p-3 bg-primary-subtle text-primary rounded-circle">
            <i class="fa-solid fa-coins fs-4"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-6 col-lg-3">
      <div class="custom-card p-3 border-0 shadow-sm border-start border-4 border-success">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <div class="text-muted small fw-semibold">ĐƠN HOÀN TẤT</div>
            <div class="fs-4 fw-bold text-dark mt-1" id="statOrders">0</div>
          </div>
          <div class="p-3 bg-success-subtle text-success rounded-circle">
            <i class="fa-solid fa-circle-check fs-4"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-6 col-lg-3">
      <div class="custom-card p-3 border-0 shadow-sm border-start border-4 border-warning">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <div class="text-muted small fw-semibold">ĐƠN CHỜ TIẾP NHẬN</div>
            <div class="fs-4 fw-bold text-dark mt-1"><%= pendingOrders %></div>
          </div>
          <div class="p-3 bg-warning-subtle text-warning rounded-circle">
            <i class="fa-solid fa-clock fs-4"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-6 col-lg-3">
      <div class="custom-card p-3 border-0 shadow-sm border-start border-4 border-info">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <div class="text-muted small fw-semibold">MÓN TRÊN THỰC ĐƠN</div>
            <div class="fs-4 fw-bold text-dark mt-1"><%= totalProducts %></div>
          </div>
          <div class="p-3 bg-info-subtle text-info rounded-circle">
            <i class="fa-solid fa-bowl-food fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Charts Row -->
  <div class="row g-4 mb-4">
    <div class="col-lg-8">
      <div class="custom-card p-4 border-0 shadow-sm h-100">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h5 class="fw-bold mb-0"><i class="fa-solid fa-chart-column text-primary me-2"></i> Xu Hướng Doanh Thu (7 Ngày Gần Nhất)</h5>
        </div>
        <div style="height: 300px;">
          <canvas id="revenueChart"></canvas>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="custom-card p-4 border-0 shadow-sm h-100">
        <h5 class="fw-bold mb-3"><i class="fa-solid fa-pie-chart text-primary me-2"></i> Phương Thức Thanh Toán</h5>
        <div style="height: 250px;">
          <canvas id="paymentChart"></canvas>
        </div>
        <div id="paymentSummaryText" class="mt-3 small text-muted text-center"></div>
      </div>
    </div>
  </div>

  <!-- Top Products Table -->
  <div class="custom-card p-4 border-0 shadow-sm">
    <h5 class="fw-bold mb-3"><i class="fa-solid fa-trophy text-warning me-2"></i> Top Món Bán Chạy Nhất (Bestsellers)</h5>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th style="width: 60px;">#</th>
            <th>Món Ăn</th>
            <th>Danh Mục</th>
            <th>Đơn Giá</th>
            <th>Số Lượng Đã Bán</th>
            <th>Trạng Thái</th>
          </tr>
        </thead>
        <tbody id="topProductsBody">
          <!-- Rendered by JS -->
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
let revenueChartInstance = null;
let paymentChartInstance = null;

async function loadDashboardStats() {
  try {
    const [overviewRes, chartRes] = await Promise.all([
      fetch('/api/admin/reports/overview'),
      fetch('/api/admin/reports/revenue-chart?days=7')
    ]);

    const overviewData = await overviewRes.json();
    const chartData = await chartRes.json();

    if (overviewData.success) {
      const { summary, paymentMethods, topProducts } = overviewData.data;
      document.getElementById('statRevenue').textContent = formatCurrency(summary.totalRevenue);
      document.getElementById('statOrders').textContent = summary.totalOrders || 0;

      // Render Top Products
      const topBody = document.getElementById('topProductsBody');
      topBody.innerHTML = topProducts.map((p, idx) => `
        <tr>
          <td>
            <span class="badge ${idx < 3 ? 'bg-warning text-dark' : 'bg-light text-dark border'} rounded-circle" style="width: 26px; height: 26px; line-height: 18px;">
              ${idx + 1}
            </span>
          </td>
          <td>
            <div class="d-flex align-items-center gap-2">
              <img src="${(p.images && p.images[0]) || '/images/default-food.png'}" class="rounded-2" style="width: 40px; height: 40px; object-fit: cover;">
              <span class="fw-semibold">${p.name}</span>
            </div>
          </td>
          <td><span class="badge bg-light text-dark border">${p.category ? p.category.name : 'N/A'}</span></td>
          <td class="fw-semibold">${formatCurrency(p.price)}</td>
          <td><strong class="text-success">${p.soldCount}</strong> phần</td>
          <td>
            <span class="badge ${p.isAvailable ? 'bg-success-subtle text-success border border-success' : 'bg-danger-subtle text-danger'}">
              ${p.isAvailable ? 'Còn hàng' : 'Hết hàng'}
            </span>
          </td>
        </tr>
      `).join('');

      // Render Payment Chart
      renderPaymentChart(paymentMethods);
    }

    if (chartData.success) {
      renderRevenueChart(chartData.data);
    }
  } catch (err) {
    console.error('Lỗi tải thống kê:', err);
  }
}

function renderRevenueChart(data) {
  const ctx = document.getElementById('revenueChart').getContext('2d');
  const labels = data.map((d) => d._id);
  const revenues = data.map((d) => d.revenue);

  if (revenueChartInstance) revenueChartInstance.destroy();

  revenueChartInstance = new Chart(ctx, {
    type: 'bar',
    data: {
      labels: labels.length ? labels : ['Hôm nay'],
      datasets: [{
        label: 'Doanh thu (VNĐ)',
        data: revenues.length ? revenues : [0],
        backgroundColor: 'rgba(79, 70, 229, 0.75)',
        borderColor: '#4f46e5',
        borderWidth: 1,
        borderRadius: 8
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false }
      },
      scales: {
        y: {
          beginAtZero: true,
          ticks: {
            callback: (v) => formatCurrency(v)
          }
        }
      }
    }
  });
}

function renderPaymentChart(methods) {
  const ctx = document.getElementById('paymentChart').getContext('2d');
  const labels = methods.map((m) => {
    if (m._id === 'cash') return 'Tiền mặt';
    if (m._id === 'transfer') return 'Chuyển khoản';
    if (m._id === 'card') return 'Thẻ';
    return m._id || 'Khác';
  });
  const values = methods.map((m) => m.totalAmount);

  if (paymentChartInstance) paymentChartInstance.destroy();

  paymentChartInstance = new Chart(ctx, {
    type: 'doughnut',
    data: {
      labels: labels.length ? labels : ['Chưa có dữ liệu'],
      datasets: [{
        data: values.length ? values : [1],
        backgroundColor: ['#10b981', '#0ea5e9', '#f59e0b', '#64748b']
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false
    }
  });
}

document.addEventListener('DOMContentLoaded', () => {
  loadDashboardStats();
});
</script>
