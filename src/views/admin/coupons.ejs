<div class="container-fluid px-md-4 py-3">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
      <h3 class="fw-bold mb-1"><i class="fa-solid fa-ticket text-primary me-2"></i> Quản Lý Mã Giảm Giá (Coupons)</h3>
      <p class="text-muted small mb-0">Tạo mã ưu đãi theo phần trăm hoặc số tiền cố định cho khách hàng</p>
    </div>
    <div>
      <button class="btn btn-primary rounded-pill px-4 fw-semibold" onclick="openCreateCouponModal()">
        <i class="fa-solid fa-plus me-1"></i> Tạo Mã Giảm Giá
      </button>
    </div>
  </div>

  <div class="custom-card p-4 border-0 shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Mã Code</th>
            <th>Loại Giảm</th>
            <th>Giá Trị</th>
            <th>Đơn Tối Thiểu</th>
            <th>Giảm Tối Đa</th>
            <th>Lượt Dùng</th>
            <th>Trạng Thái</th>
            <th class="text-end">Hành Động</th>
          </tr>
        </thead>
        <tbody>
          <% coupons.forEach(c => { %>
            <tr id="coupon-row-<%= c._id %>">
              <td><span class="badge bg-dark fs-6 font-monospace"><%= c.code %></span></td>
              <td><span class="badge bg-light text-dark border"><%= c.type === 'percent' ? 'Phần trăm (%)' : 'Số tiền cố định' %></span></td>
              <td class="fw-bold text-success"><%= c.type === 'percent' ? `${c.value}%` : `${c.value.toLocaleString('vi-VN')}đ` %></td>
              <td><%= c.minOrder ? `${c.minOrder.toLocaleString('vi-VN')}đ` : 'Không có' %></td>
              <td><%= c.maxDiscount ? `${c.maxDiscount.toLocaleString('vi-VN')}đ` : 'Không giới hạn' %></td>
              <td><%= c.usedCount %> / <%= c.usageLimit > 0 ? c.usageLimit : '∞' %></td>
              <td>
                <span class="badge <%= c.isActive ? 'bg-success' : 'bg-secondary' %>">
                  <%= c.isActive ? 'Đang bật' : 'Đã khóa' %>
                </span>
              </td>
              <td class="text-end">
                <button class="btn btn-sm btn-outline-danger rounded-circle" style="width: 34px; height: 34px;"
                        onclick="deleteCoupon('<%= c._id %>')" title="Xóa mã">
                  <i class="fa-solid fa-trash"></i>
                </button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal Thêm Mã Giảm Giá -->
<div class="modal fade" id="couponModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg">
      <div class="modal-header">
        <h5 class="modal-title fw-bold">Tạo Mã Giảm Giá Mới</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-4">
        <div class="mb-3">
          <label class="form-label fw-semibold">Mã code <span class="text-danger">*</span></label>
          <input type="text" id="cpCode" class="form-control text-uppercase" placeholder="GIAM20K, CHAOBANMOI..." required>
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold">Loại giảm giá</label>
          <select id="cpType" class="form-select">
            <option value="percent">Phần trăm (%)</option>
            <option value="fixed">Số tiền cố định (VNĐ)</option>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold">Giá trị giảm <span class="text-danger">*</span></label>
          <input type="number" id="cpValue" class="form-control" placeholder="VD: 10 (cho 10%) hoặc 20000 (cho 20.000đ)" required min="1">
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold">Đơn hàng tối thiểu (VNĐ)</label>
          <input type="number" id="cpMinOrder" class="form-control" value="0" min="0" placeholder="50000">
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold">Giảm tối đa (áp dụng cho %)</label>
          <input type="number" id="cpMaxDiscount" class="form-control" value="0" min="0" placeholder="30000">
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold">Giới hạn số lượt dùng (0 = không giới hạn)</label>
          <input type="number" id="cpUsageLimit" class="form-control" value="0" min="0">
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Hủy</button>
        <button type="button" class="btn btn-primary rounded-pill px-4" onclick="saveCoupon()">Tạo Mã Giảm Giá</button>
      </div>
    </div>
  </div>
</div>

<script>
function openCreateCouponModal() {
  document.getElementById('cpCode').value = '';
  document.getElementById('cpValue').value = '';
  new bootstrap.Modal(document.getElementById('couponModal')).show();
}

async function saveCoupon() {
  const code = document.getElementById('cpCode').value.trim().toUpperCase();
  const type = document.getElementById('cpType').value;
  const value = Number(document.getElementById('cpValue').value);
  const minOrder = Number(document.getElementById('cpMinOrder').value) || 0;
  const maxDiscount = Number(document.getElementById('cpMaxDiscount').value) || 0;
  const usageLimit = Number(document.getElementById('cpUsageLimit').value) || 0;

  if (!code || !value) {
    Swal.fire({ icon: 'warning', title: 'Thiếu thông tin', text: 'Vui lòng nhập mã code và giá trị giảm' });
    return;
  }

  try {
    const res = await fetch('/api/admin/coupons', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ code, type, value, minOrder, maxDiscount, usageLimit })
    });
    const result = await res.json();
    if (!result.success) throw new Error(result.message);

    bootstrap.Modal.getInstance(document.getElementById('couponModal')).hide();
    await Swal.fire({ icon: 'success', title: 'Thành công', text: 'Đã tạo mã giảm giá!' });
    window.location.reload();
  } catch (err) {
    Swal.fire({ icon: 'error', title: 'Lỗi', text: err.message });
  }
}

async function deleteCoupon(id) {
  const confirm = await Swal.fire({
    title: 'Xóa mã giảm giá này?',
    icon: 'warning',
    showCancelButton: true,
    confirmButtonText: 'Đồng ý'
  });
  if (!confirm.isConfirmed) return;

  try {
    const res = await fetch(`/api/admin/coupons/${id}`, { method: 'DELETE' });
    const result = await res.json();
    if (!result.success) throw new Error(result.message);

    document.getElementById(`coupon-row-${id}`).remove();
    Swal.fire({ icon: 'success', title: 'Đã xóa mã giảm giá' });
  } catch (err) {
    Swal.fire({ icon: 'error', title: 'Lỗi', text: err.message });
  }
}
</script>
