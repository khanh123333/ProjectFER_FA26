<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="custom-card p-4 p-md-5 border-0 shadow-lg">
        <div class="text-center mb-4">
          <div class="d-inline-flex p-3 rounded-circle bg-primary-subtle text-primary mb-3">
            <i class="fa-solid fa-lock" style="font-size: 2rem;"></i>
          </div>
          <h3 class="fw-bold mb-1">Đăng Nhập</h3>
          <p class="text-muted small">Quản lý hoặc đặt món ăn cùng Coffee & Tea House</p>
        </div>

        <form id="loginForm">
          <div class="mb-3">
            <label class="form-label fw-semibold">Email</label>
            <div class="input-group">
              <span class="input-group-text"><i class="fa-solid fa-envelope text-muted"></i></span>
              <input type="email" id="email" class="form-control" required>
            </div>
          </div>

          <div class="mb-4">
            <label class="form-label fw-semibold">Mật khẩu</label>
            <div class="input-group">
              <span class="input-group-text"><i class="fa-solid fa-key text-muted"></i></span>
              <input type="password" id="password" class="form-control" required>
            </div>
          </div>

          <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold rounded-pill mb-3" id="btnLogin">
            <i class="fa-solid fa-right-to-bracket me-1"></i> Đăng Nhập
          </button>
        </form>

        <div class="text-center mt-4 text-muted small">
          Chưa có tài khoản khách? <a href="/register" class="text-primary fw-semibold">Đăng ký ngay</a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>

document.getElementById('loginForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const email = document.getElementById('email').value.trim();
  const password = document.getElementById('password').value;
  const btn = document.getElementById('btnLogin');

  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang đăng nhập...';

  try {
    const res = await fetch('/api/auth/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email, password })
    });
    const result = await res.json();

    if (!result.success) {
      throw new Error(result.message || 'Đăng nhập không thành công');
    }

    const role = result.data.user.role;
    const urlParams = new URLSearchParams(window.location.search);
    const redirect = urlParams.get('redirect');

    if (redirect) {
      window.location.href = redirect;
    } else if (role === 'admin') {
      window.location.href = '/admin/dashboard';
    } else if (role === 'staff') {
      window.location.href = '/staff/dashboard';
    } else {
      window.location.href = '/menu';
    }
  } catch (err) {
    Swal.fire({
      icon: 'error',
      title: 'Lỗi đăng nhập',
      text: err.message
    });
  } finally {
    btn.disabled = false;
    btn.innerHTML = '<i class="fa-solid fa-right-to-bracket me-1"></i> Đăng Nhập';
  }
});
</script>
