<div class="container py-5 text-center">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
      <div class="custom-card p-5 border-0 shadow-lg">
        <div class="mb-4">
          <i class="fa-solid fa-triangle-exclamation text-danger" style="font-size: 4rem;"></i>
        </div>
        <h2 class="fw-bold mb-3"><%= title || 'Đã có lỗi xảy ra' %></h2>
        <p class="text-muted mb-4"><%= message || 'Rất tiếc, yêu cầu của bạn không thể thực hiện được hoặc trang không tồn tại.' %></p>
        <div class="d-flex justify-content-center gap-3">
          <a href="/" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="fa-solid fa-house me-1"></i> Trang chủ
          </a>
          <button onclick="window.history.back()" class="btn btn-primary rounded-pill px-4">
            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
