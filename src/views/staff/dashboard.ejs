      <div class="col-md-7 col-lg-8">
        <div class="d-flex gap-2 overflow-x-auto pb-1" id="resFilterTabs" style="scrollbar-width: thin;">
          <button class="btn btn-sm btn-dark rounded-pill px-3 fw-semibold active" onclick="setResFilter('', this)">
            Tất Cả <span class="badge bg-light text-dark ms-1" id="resCountAll">0</span>
          </button>
          <button class="btn btn-sm btn-outline-warning text-dark rounded-pill px-3 fw-semibold" onclick="setResFilter('pending', this)">
            Chờ Xác Nhận <span class="badge bg-warning text-dark ms-1" id="resCountPending">0</span>
          </button>
          <button class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold" onclick="setResFilter('confirmed', this)">
