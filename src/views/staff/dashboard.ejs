          </button>
          <button class="btn btn-sm btn-outline-success rounded-pill px-3 fw-semibold" onclick="setResFilter('arrived', this)">
            Khách Đã Đến <span class="badge bg-success ms-1" id="resCountArrived">0</span>
          </button>
          <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-semibold" onclick="setResFilter('expired', this)">
            Quá Hạn (>15p) / Hủy
          </button>
        </div>
      </div>

      <div class="col-md-5 col-lg-4 text-md-end d-flex gap-2 justify-content-md-end">
        <button class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-semibold" onclick="triggerAutoCancelCheck()" title="Quét hủy tự động các đơn trễ quá 15 phút">
          <i class="fa-solid fa-stopwatch me-1"></i> Quét Quá Hạn 15P
        </button>
        <button class="btn btn-outline-primary btn-sm rounded-pill px-3" onclick="loadStaffReservations()">
          <i class="fa-solid fa-arrows-rotate me-1"></i> Tải Lại
        </button>
      </div>
    </div>

    <!-- Reservations Grid -->
    <div class="row g-3" id="reservationsGrid">
      <div class="col-12 text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="text-muted small mt-2">Đang tải danh sách đặt bàn...</p>
      </div>
    </div>
  </div>
</div>

