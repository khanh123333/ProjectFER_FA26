<div class="container py-3">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h3 class="fw-bold mb-1"><i class="fa-solid fa-clock-rotate-left text-primary me-2"></i> Lịch Sử Đơn Hàng Của Tôi</h3>
      <p class="text-muted small mb-0">Các đơn bạn đã đặt khi đăng nhập tài khoản</p>
    </div>
    <a href="/menu" class="btn btn-primary rounded-pill btn-sm px-3">
      <i class="fa-solid fa-plus me-1"></i> Đặt Đơn Mới
    </a>
  </div>

  <% if (orders && orders.length > 0) { %>
    <div class="row g-3">
      <% orders.forEach(order => { %>
        <div class="col-md-6 col-lg-4">
          <div class="custom-card p-3 border h-100 d-flex flex-column justify-content-between">
            <div>
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="badge bg-light text-dark border">
                  <%= order.table ? order.table.tableNumber : 'N/A' %>
                </span>
                <span class="badge rounded-pill text-uppercase <%= order.status === 'completed' ? 'bg-success' : (order.status === 'cancelled' || order.status === 'rejected' ? 'bg-danger' : 'bg-primary') %>">
                  <%= order.status %>
                </span>
              </div>

              <h6 class="fw-bold mb-1">Đơn #<%= order.orderCode %></h6>
              <div class="text-muted small mb-2">
                <i class="fa-regular fa-calendar me-1"></i> <%= new Date(order.createdAt).toLocaleString('vi-VN') %>
              </div>

              <div class="p-2 bg-light rounded-3 mb-2 small text-truncate">
                <%= order.items ? order.items.map(it => `${it.quantity}x ${it.nameSnapshot}`).join(', ') : '' %>
              </div>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-2">
              <span class="fw-bold text-primary"><%= order.totalAmount.toLocaleString('vi-VN') %>đ</span>
              <div class="d-flex gap-2">
                <% if (order.status === 'pending' && !order.isLocked) { %>
                  <button class="btn btn-outline-danger btn-sm rounded-pill px-3" onclick="cancelMyOrderFromList('<%= order._id %>')">
                    <i class="fa-solid fa-xmark me-1"></i> Hủy đơn
                  </button>
                <% } %>
                <a href="/order-status/<%= order.orderCode %>" class="btn btn-outline-primary btn-sm rounded-pill">
                  Chi tiết <i class="fa-solid fa-arrow-right ms-1"></i>
                </a>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="custom-card p-5 text-center">
      <i class="fa-solid fa-receipt text-muted opacity-25 mb-3" style="font-size: 3.5rem;"></i>
      <h5 class="fw-bold text-secondary">Bạn chưa có đơn hàng nào</h5>
      <p class="text-muted small">Hãy chọn món tại bàn để trải nghiệm dịch vụ của chúng tôi nhé!</p>
      <a href="/menu" class="btn btn-primary rounded-pill px-4">
        Khám phá menu ngay
      </a>
    </div>
  <% } %>
</div>

<script>
async function cancelMyOrderFromList(orderId) {
  const { value: reason, isConfirmed } = await Swal.fire({
    title: 'Hủy Đơn Hàng?',
    input: 'text',
    inputLabel: 'Lý do bạn muốn hủy đơn',
    inputPlaceholder: 'Nhập lý do (ví dụ: đổi ý, bận đột xuất...)',
    showCancelButton: true,
    confirmButtonColor: '#d33',
    confirmButtonText: 'Xác Nhận Hủy',
    cancelButtonText: 'Không hủy'
  });

  if (!isConfirmed) return;

  try {
    const res = await fetch(`/api/customer/orders/${orderId}/cancel`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ reason: reason || 'Khách hủy đơn' })
    });
    const result = await res.json();
    if (!res.ok) throw new Error(result.message || 'Lỗi khi hủy đơn');

    await Swal.fire({ icon: 'success', title: 'Đã hủy đơn thành công', timer: 1500, showConfirmButton: false });
    window.location.reload();
  } catch (err) {
    Swal.fire({ icon: 'error', title: 'Lỗi hủy đơn', text: err.message });
  }
}
</script>
