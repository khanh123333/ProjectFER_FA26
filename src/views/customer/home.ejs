<div class="container py-3">
  <!-- Hero Banner -->
  <div class="p-4 p-md-5 mb-4 rounded-4 text-white shadow-lg" style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 40%, #4338ca 100%);">
    <div class="row align-items-center">
      <div class="col-lg-7">
        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-3">
          <i class="fa-solid fa-sparkles me-1"></i> Trải nghiệm gọi món thông minh
        </span>
        <h1 class="display-5 fw-bold mb-3">Thưởng Thức Hương Vị Đậm Đà Tại Bàn</h1>
        <p class="lead text-light opacity-75 mb-4">
          Chạm chọn bàn trực tiếp ngay trên ứng dụng, tùy chỉnh lượng đường, đá, topping theo ý thích và theo dõi trạng thái chế biến theo thời gian thực!
        </p>
        <div class="d-flex flex-wrap gap-3">
          <a href="#tableSection" class="btn btn-warning btn-lg px-4 py-2 rounded-pill fw-bold text-dark shadow-sm">
            <i class="fa-solid fa-chair me-2"></i> Chọn Bàn & Đặt Món
          </a>
          <a href="/menu" class="btn btn-outline-light btn-lg px-4 py-2 rounded-pill fw-semibold">
            <i class="fa-solid fa-book-open me-2"></i> Xem Thực Đơn
          </a>
        </div>
      </div>
      <div class="col-lg-5 text-center mt-4 mt-lg-0">
        <img src="https://images.unsplash.com/photo-1558857563-b371033873b8?auto=format&fit=crop&w=600&q=80" 
             class="img-fluid rounded-4 shadow-lg border border-3 border-white border-opacity-25" 
             alt="Coffee & Tea" 
             style="max-height: 280px; width: 100%; object-fit: cover;">
      </div>
    </div>
  </div>

  <!-- Chọn Bàn Ngồi (Sơ Đồ Bàn Chạm Trực Tiếp) -->
  <div id="tableSection" class="mt-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
      <div>
        <h3 class="fw-bold mb-1"><i class="fa-solid fa-couch text-primary me-2"></i> Sơ Đồ Bàn - Chạm Để Chọn</h3>
        <p class="text-muted small mb-0">Quý khách hoặc nhân viên vui lòng chạm vào số bàn đang ngồi để mở thực đơn gọi món</p>
      </div>
      <div class="d-flex align-items-center gap-2">
        <span class="badge bg-success-subtle text-success border border-success px-3 py-2 rounded-pill">
          <i class="fa-solid fa-circle me-1"></i> Bàn trống
        </span>
        <span class="badge bg-danger-subtle text-danger border border-danger px-3 py-2 rounded-pill">
          <i class="fa-solid fa-circle me-1"></i> Đang có khách
        </span>
      </div>
    </div>

    <div class="row g-3">
      <% tables.forEach(table => { %>
        <% const isEmpty = table.status === 'empty'; %>
        <div class="col-6 col-md-4 col-lg-3 col-xl-2">
          <a href="/menu?table=<%= encodeURIComponent(table.tableNumber) %>" 
             class="table-pick-card <%= isEmpty ? 'table-is-empty' : 'table-is-occupied' %> h-100">
            <div>
              <!-- Top Badges -->
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="badge rounded-pill <%= isEmpty ? 'bg-success text-white' : 'bg-danger text-white' %> px-2 py-1" style="font-size: 0.7rem;">
                  <%= isEmpty ? 'Trống' : 'Có khách' %>
                </span>
                <span class="text-muted small">
                  <i class="fa-solid fa-user-group me-1"></i><%= table.capacity %> chỗ
                </span>
              </div>

              <!-- Chair / Table Icon -->
              <div class="table-avatar-icon">
                <i class="fa-solid fa-chair"></i>
              </div>

              <!-- Table Number -->
              <h5 class="fw-bold mb-1 text-dark"><%= table.tableNumber %></h5>
              <div class="small <%= isEmpty ? 'text-success' : 'text-danger' %> mb-3 fw-medium">
                <%= isEmpty ? 'Sẵn sàng phục vụ' : 'Đang phục vụ' %>
              </div>
            </div>

            <!-- Action Button -->
            <div class="btn btn-sm <%= isEmpty ? 'btn-primary' : 'btn-outline-danger' %> w-100 rounded-pill fw-semibold py-1">
              <i class="fa-solid <%= isEmpty ? 'fa-arrow-right' : 'fa-plus' %> me-1"></i>
              <%= isEmpty ? 'Chọn Bàn' : 'Gọi Thêm Món' %>
            </div>
          </a>
        </div>
      <% }) %>
    </div>
  </div>
</div>
